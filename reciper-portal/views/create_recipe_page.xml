<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="create_recipe_template" name="Create Recipe Page">
        <t t-call="portal.portal_layout">
            <form action="/my/shopping/recipe/create" method="post" enctype="multipart/form-data"
                  class="create_recipe_form container py-3">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <h1 class="h3 mb-3">Créer une recette</h1>

                <div class="form-group row">
                    <label class="col-12 col-md-3 col-form-label" for="name">Nom</label>
                    <div class="col-12 col-md-9">
                        <input type="text" id="name" name="name" class="form-control" required="required"/>
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-12 col-md-3 col-form-label" for="people_count">Nombre de personnes</label>
                    <div class="col-12 col-md-9">
                        <input type="number" id="people_count" name="people_count" min="1" step="1" value="1"
                               class="form-control"/>
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-12 col-md-3 col-form-label" for="category">Catégorie</label>
                    <div class="col-12 col-md-9">
                        <select id="category" name="category" class="form-control select2_box">
                            <option value="">Sélectionner une catégorie</option>
                            <t t-foreach="categories" t-as="category">
                                <option t-att-value="category[0]">
                                    <t t-esc="category[1]"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-12 col-md-3 col-form-label" for="image">Photo</label>
                    <div class="col-12 col-md-9">
                        <input type="file" id="image" name="image" accept="image/*" class="form-control"/>
                    </div>
                </div>

                <h5 class="mt-4">Ingrédients</h5>
                <div id="ingredient_lines">
                    <div class="d-flex flex-row flex-nowrap mb-1 align-items-end">
                        <div class="p-1 flex-fill">
                            <label class="form-label small mb-0">Ingrédient</label>
                        </div>
                        <div class="p-1" style="flex: 0 0 100px;">
                            <label class="form-label small mb-0">Quantité</label>
                        </div>
                        <div class="p-1" style="flex: 0 0 100px;">
                            <label class="form-label small mb-0">Unité</label>
                        </div>
                        <div style="flex: 0 0 40px;"></div>
                    </div>

                    <!-- Template caché pour nouvelle ligne -->
                    <div class="ingredient-line-container d-flex flex-row flex-nowrap mb-2 align-items-end d-none"
                         id="ingredient_template">
                        <div class="p-1 flex-fill">
                            <select name="ingredient_id" class="form-control w-100">
                                <option/>
                                <t t-foreach="ingredients" t-as="ingredient">
                                    <option t-att-value="ingredient.id" t-att-data-uom="ingredient.uom_id.name">
                                        <t t-esc="ingredient.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="p-1" style="flex: 0 0 100px;">
                            <input type="number" min="0" step="0.01" name="quantity" class="form-control" value="1"/>
                        </div>
                        <div class="p-1 ingredient-line-uom text-muted small d-flex align-items-center"
                             style="flex: 0 0 100px;"></div>
                        <div class="p-1" style="flex: 0 0 40px;">
                            <button type="button" class="btn btn-danger remove-line px-2">×</button>
                        </div>
                    </div>
                </div>

                <h5 class="mt-4">Instructions</h5>
                <div class="form-group row">
                    <div class="col-12">
                        <textarea name="instructions" class="form-control w-100" rows="8"></textarea>
                    </div>
                </div>

                <div class="mt-4 clearfix">
                    <button type="submit" class="btn btn-primary float-right mb-2">Créer la recette</button>
                </div>
            </form>

            <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap4.min.css" rel="stylesheet"/>
            <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
        </t>
    </template>
</odoo>
